# Copy to .env and load with your preferred environment manager. Do not commit credentials.

# Preferred configurable YOLO checkpoint. Defaults to model.pt when present.
# To explicitly select a multi-class checkpoint: CIVISCAN_MODEL_PATH=.\best.pt
CIVISCAN_MODEL_PATH=.\model.pt
CIVISCAN_YOLOV8_FALLBACK_PATH=.\yolov8_pothole_best.pt
CIVISCAN_CONFIDENCE_THRESHOLD=0.44

CIVISCAN_DATABASE_PATH=.\civiscan.db
CIVISCAN_DATA_DIR=.\data
CIVISCAN_INCOMING_IMAGE_DIR=.\data\incoming_images
CIVISCAN_PROCESSING_DIR=.\data\processing
CIVISCAN_DATA_PROCESSED_DIR=.\data\processed
CIVISCAN_FAILED_MEDIA_DIR=.\data\failed
CIVISCAN_EXTRACTED_FRAMES_DIR=.\data\extracted_frames
CIVISCAN_ANNOTATED_MEDIA_DIR=.\data\annotated_results
CIVISCAN_FRAME_INTERVAL_SECONDS=2
CIVISCAN_MAX_VIDEO_FRAMES=100
CIVISCAN_INCOMING_POLL_SECONDS=3

CIVISCAN_THEME=Light

# Optional SMTP delivery; leave unset until a trusted mail relay is configured.
CIVISCAN_SMTP_HOST=
CIVISCAN_SMTP_PORT=587
CIVISCAN_SMTP_USERNAME=
CIVISCAN_SMTP_PASSWORD=
CIVISCAN_SMTP_FROM_EMAIL=
CIVISCAN_PUBLIC_URL=http://localhost:8501
